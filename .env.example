# Hirance Live Challenge Competition Server Configuration

DATABASE_URL=postgresql://hirance:hirance@localhost:5432/hirance?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379

API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Key authentication (Static event access key & Admin key)
EVENT_ACCESS_KEY=event-access-key-secret
ADMIN_KEY=admin-key-secret

# Webhook secret for POST /api/integrations/job-events
EXTERNAL_JOB_WEBHOOK_SECRET=webhook-secret-change-me
EXTERNAL_JOB_WEBHOOK_SKEW_SECONDS=300
EXTERNAL_JOB_WEBHOOK_ENABLED=true

# Rate limits (ttl in ms)
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_COMPETITION_TTL_MS=10000
THROTTLE_COMPETITION_LIMIT=120

# LiveKit SFU for competition screen sharing
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Frontend env vars (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_EVENT_KEY=event-access-key-secret
