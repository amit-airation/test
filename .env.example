# Hirance Live Challenge Competition Server Configuration
#
# Local: copy to apps/api/.env and apps/web/.env.local as needed.
# Production / Docker Compose: copy to repo-root .env (see docs/DEPLOYMENT.md).
# In production every *KEY / SECRET below must be ≥ 32 random characters.

DATABASE_URL=postgresql://hirance:hirance@localhost:5432/hirance?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379

API_PORT=3001
# Production: exact UI origin(s), never *
CORS_ORIGIN=http://localhost:3000

# Key authentication (no JWT / no /auth)
# Production: openssl rand -hex 32  (for each)
EVENT_ACCESS_KEY=event-access-key-secret-at-least-32ch
ADMIN_KEY=admin-key-secret-at-least-32-characters
# Browser must use the same value as EVENT_ACCESS_KEY
NEXT_PUBLIC_EVENT_KEY=event-access-key-secret-at-least-32ch

# Webhook secret for POST /api/integrations/job-events (HMAC)
EXTERNAL_JOB_WEBHOOK_SECRET=webhook-secret-change-me-at-least-32
EXTERNAL_JOB_WEBHOOK_SKEW_SECONDS=300
EXTERNAL_JOB_WEBHOOK_ENABLED=true

# Rate limits (ttl in ms)
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_COMPETITION_TTL_MS=10000
THROTTLE_COMPETITION_LIMIT=120

# LiveKit SFU for competition screen sharing
# Production: strong unique key/secret; weak "devkey"/"secret" fail boot
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Frontend (baked into Next.js at build time for Docker/web)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001
