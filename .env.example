# Hirance Live Challenge — environment template
#
# Live / EC2: copy to repo-root `.env` (Compose env_file + build args).
# Local API-only: also sync keys into apps/api/.env; web uses apps/web/.env.local.
#
# Production boot requires (≥ 32 chars): ADMIN_KEY, EVENT_ACCESS_KEY,
# EXTERNAL_JOB_WEBHOOK_SECRET, and CORS_ORIGIN ≠ *.
# NEXT_PUBLIC_EVENT_KEY must equal EVENT_ACCESS_KEY (web build).
# Screen share: set LIVEKIT_* to your LiveKit Cloud project (staging + prod).

NODE_ENV=production

DATABASE_URL=postgresql://hirance:hirance@localhost:5432/hirance?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379

API_PORT=3001
CORS_ORIGIN=https://test.amitverma01.dev

# Key auth (no JWT)
ADMIN_KEY=replace-with-openssl-rand-hex-32-admin-key!!
EVENT_ACCESS_KEY=replace-with-openssl-rand-hex-32-event-key!!
NEXT_PUBLIC_EVENT_KEY=replace-with-openssl-rand-hex-32-event-key!!

# Job-server webhook HMAC
EXTERNAL_JOB_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32-webhook!!
EXTERNAL_JOB_WEBHOOK_SKEW_SECONDS=300
EXTERNAL_JOB_WEBHOOK_ENABLED=true

THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_COMPETITION_TTL_MS=10000
THROTTLE_COMPETITION_LIMIT=120
THROTTLE_WS_CONNECT_TTL_MS=60000
THROTTLE_WS_CONNECT_LIMIT=60

# LiveKit Cloud (required for screen share in staging + production)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=replace-with-livekit-cloud-api-secret
# Optional self-hosted SFU only: docker compose --profile self-hosted-livekit up -d
LIVEKIT_NODE_IP=

UI_SERVER_NAME=test.amitverma01.dev
API_SERVER_NAME=api.test.amitverma01.dev
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
DOMAINS=test.amitverma01.dev,api.test.amitverma01.dev
EMAIL=amitz.airation@gmail.com

NEXT_PUBLIC_API_URL=https://api.test.amitverma01.dev/api
NEXT_PUBLIC_WS_URL=https://api.test.amitverma01.dev
