# Staging values live in repo-root `.env` (gitignored) and are mirrored to
# apps/api/.env + apps/web/.env.local for EC2 testing on:
#   UI      https://test.amitverma01.dev
#   API     https://api.test.amitverma01.dev
#   LiveKit wss://live.test.amitverma01.dev
# Rotate JWT / webhook / bootstrap / LiveKit secrets before any shared use.

DATABASE_URL=postgresql://hirance:hirance@localhost:5432/hirance?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379

# Must be 32+ unique characters; the API refuses to boot in production otherwise.
JWT_SECRET=change-me
API_PORT=3001

# Deployed hosts:
#   UI  https://test.amitverma01.dev
#   API https://api.test.amitverma01.dev
#   LiveKit wss://live.test.amitverma01.dev
# External job server (not this repo): https://api.hirance.com
#   → webhook target:
#     https://api.test.amitverma01.dev/api/integrations/job-events
CORS_ORIGIN=https://test.amitverma01.dev

# Out-of-band token that allows creating the *first* ADMIN account via
# POST /api/auth/admins. Disabled automatically once any admin exists.
# Leave empty to keep admin provisioning closed to existing admins only.
ADMIN_BOOTSTRAP_TOKEN=

# This service does NOT create jobs. Scores arrive only via the job-server
# webhook: POST /api/integrations/job-events (HMAC-SHA256).
EXTERNAL_JOB_WEBHOOK_SECRET=
EXTERNAL_JOB_WEBHOOK_SKEW_SECONDS=300
# Soft kill-switch for ingest (default true).
EXTERNAL_JOB_WEBHOOK_ENABLED=true
# When true, register/join require a job-server externalUserId.
REQUIRE_EXTERNAL_USER_ID_ON_JOIN=false

# Rate limits (ttl in ms). `competition` covers leaderboard and webhook ingest.
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_COMPETITION_TTL_MS=10000
THROTTLE_COMPETITION_LIMIT=120
THROTTLE_WS_CONNECT_TTL_MS=60000
THROTTLE_WS_CONNECT_LIMIT=60

# LiveKit SFU for competition screen sharing.
# Staging (EC2): matches docker/livekit/livekit.staging.yaml — strong keys required
# when NODE_ENV=production. Local --dev only: docker compose up -d livekit +
# LIVEKIT_API_KEY=devkey LIVEKIT_API_SECRET=secret (not for production boot).
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=wss://live.test.amitverma01.dev
LIVEKIT_API_KEY=APIstaginghirance01
LIVEKIT_API_SECRET=staging-livekit-api-secret-at-least-32-chars!!

# Nginx edge (EC2 Ubuntu)
# sudo bash scripts/ec2-bootstrap.sh
# npm run ssl:cert && npm run edge:up
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# API_UPSTREAM=host.docker.internal:3001
# WEB_UPSTREAM=host.docker.internal:3000
# LIVEKIT_UPSTREAM=livekit:7880
UI_SERVER_NAME=test.amitverma01.dev
API_SERVER_NAME=api.test.amitverma01.dev
LIVEKIT_SERVER_NAME=live.test.amitverma01.dev
# TLS SAN: npm run ssl:cert  (EMAIL=amitz.airation@gmail.com)
# DOMAINS=test.amitverma01.dev,api.test.amitverma01.dev,live.test.amitverma01.dev
# Renew cron: npm run ssl:renew

# Baked into the Next.js client at build time:
NEXT_PUBLIC_API_URL=https://api.test.amitverma01.dev/api
NEXT_PUBLIC_WS_URL=https://api.test.amitverma01.dev

# Load / capacity scripts (optional):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Or first-admin only: ADMIN_BOOTSTRAP_TOKEN=
# PARTICIPANTS=100 OBSERVERS=10 PUBLISHES_PER=2
# SOCKETS=100
