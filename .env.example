DATABASE_URL=postgresql://hirance:hirance@localhost:5432/hirance?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379

# Must be 32+ unique characters; the API refuses to boot in production otherwise.
JWT_SECRET=change-me
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Out-of-band token that allows creating the *first* ADMIN account via
# POST /api/auth/admins. Disabled automatically once any admin exists.
# Leave empty to keep admin provisioning closed to existing admins only.
ADMIN_BOOTSTRAP_TOKEN=

# HMAC secret for POST /api/integrations/job-events.
EXTERNAL_JOB_WEBHOOK_SECRET=
EXTERNAL_JOB_WEBHOOK_SKEW_SECONDS=300

# Rate limits (ttl in ms). `competition` covers the intentionally
# high-frequency create/publish and leaderboard paths.
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_COMPETITION_TTL_MS=10000
THROTTLE_COMPETITION_LIMIT=120
THROTTLE_WS_CONNECT_TTL_MS=60000
THROTTLE_WS_CONNECT_LIMIT=60

# LiveKit SFU for competition screen sharing (optional).
# Leave unset to keep screen share unavailable.
# Local docker compose --dev keys: LIVEKIT_API_KEY=devkey LIVEKIT_API_SECRET=secret
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Phase 8 load / capacity scripts (optional):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Or first-admin only: ADMIN_BOOTSTRAP_TOKEN=
# PARTICIPANTS=100 OBSERVERS=10 PUBLISHES_PER=2
# SOCKETS=100
