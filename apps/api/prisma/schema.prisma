// Hirance competition server — schema v2
// Removed: User, CompanyMembership, CompetitionParticipant, CompetitionJobScore
// Added: Round, RoundParticipant, RoundJobScore
// Company is now the sole participant identity (sourced from the main Hirance server)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum CompetitionStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

enum RoundStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  FINALIZED
  CANCELLED
}

enum ParticipantStatus {
  REGISTERED
  READY
  ACTIVE
  DISCONNECTED
  FINISHED
  DISQUALIFIED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum JobSource {
  INTERNAL
  EXTERNAL
}

enum CompetitionEventType {
  // Competition-level
  CREATED
  CANCELLED
  // Round lifecycle
  ROUND_CREATED
  ROUND_SCHEDULED
  ROUND_STARTED
  ROUND_ENDED
  ROUND_FINALIZED
  ROUND_CANCELLED
  // Participant
  REGISTERED
  JOINED
  DISCONNECTED
  RECONNECTED
  DISQUALIFIED
  // Scoring
  JOB_PUBLISHED
  JOB_UNPUBLISHED
  PUBLISH_FAILED
  // Screen share (integrity signal only)
  SCREEN_SHARE_STARTED
  SCREEN_SHARE_STOPPED
}

// ─── Models ──────────────────────────────────────────────────────────────────

/// Company record sourced from the main Hirance job server.
/// The id is the main server's UUID — passed in by participants at join time.
model Company {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants RoundParticipant[]
  jobs         Job[]
}

/// Competition is a named container for one or more sequential rounds.
/// The admin sets activeRoundId to control what observers see live.
model Competition {
  id            String            @id @default(uuid())
  name          String
  description   String?
  status        CompetitionStatus @default(DRAFT)
  /// Admin-controlled: which round is currently displayed on the observer screen.
  activeRoundId String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  rounds      Round[]
  activeRound Round?             @relation("ActiveRound", fields: [activeRoundId], references: [id])
  events      CompetitionEvent[]
}

/// A single timed round within a competition.
/// Each round has its own participants, scoring window (endAt + 3s grace), and leaderboard.
model Round {
  id               String      @id @default(uuid())
  competitionId    String
  roundNumber      Int
  name             String?
  status           RoundStatus @default(DRAFT)
  durationSeconds  Int         @default(300)
  scheduledStartAt DateTime?
  actualStartAt    DateTime?
  endAt            DateTime?
  finalizedAt      DateTime?
  winnerCompanyId  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  competition         Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  competitionAsActive Competition?       @relation("ActiveRound")
  participants        RoundParticipant[]
  jobs                Job[]
  events              CompetitionEvent[]

  @@unique([competitionId, roundNumber])
  @@index([competitionId, status])
}

/// A participant within a specific round.
/// Identity = the company (sourced from the main server) + a human-readable display name.
model RoundParticipant {
  id              String            @id @default(uuid())
  roundId         String
  companyId       String
  displayName     String
  status          ParticipantStatus @default(REGISTERED)
  joinedAt        DateTime?
  lastHeartbeatAt DateTime?
  completedAt     DateTime?
  finalScore      Int               @default(0)
  finalRank       Int?
  scoreReachedAt  DateTime?
  /// Timestamp of this participant's last successfully scored webhook.
  /// Used to compute postDurationSeconds on subsequent scores.
  lastScoredAt    DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  round   Round             @relation(fields: [roundId], references: [id], onDelete: Cascade)
  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events  CompetitionEvent[]

  @@unique([roundId, companyId])
  @@index([roundId, finalScore, scoreReachedAt])
  @@index([companyId])
}

/// Ledger: each external job can increment a participant's score at most once.
/// postDurationSeconds records elapsed time since the participant's previous scored job (informational).
model RoundJobScore {
  id                  String   @id @default(uuid())
  roundId             String
  participantId       String
  jobId               String   @unique
  postDurationSeconds Float?
  createdAt           DateTime @default(now())

  @@index([roundId, participantId])
}

/// Mirrored external job, linked to the round it was published during.
model Job {
  id             String    @id @default(uuid())
  title          String
  description    String?
  location       String?
  employmentType String?
  status         JobStatus @default(DRAFT)
  source         JobSource @default(EXTERNAL)
  publishedAt    DateTime?
  scoredAt       DateTime?
  externalJobId  String?   @unique
  companyId      String?
  roundId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  round   Round?   @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@index([roundId, status])
  @@index([companyId, status])
  @@index([source, externalJobId])
}

/// Append-only audit trail for competition and round events.
model CompetitionEvent {
  id                 String               @id @default(uuid())
  competitionId      String
  roundId            String?
  roundParticipantId String?
  eventType          CompetitionEventType
  metadata           Json?
  createdAt          DateTime             @default(now())

  competition      Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  round            Round?            @relation(fields: [roundId], references: [id], onDelete: SetNull)
  roundParticipant RoundParticipant? @relation(fields: [roundParticipantId], references: [id], onDelete: SetNull)

  @@index([competitionId, createdAt])
  @@index([roundId, createdAt])
  @@index([eventType])
  @@index([roundParticipantId, createdAt])
}
